{
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "1"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/(?:table|profile|learn|drill)/?$", "dest": "/index.html" },
    { "src": "^/(?:review|replay)(?:/[^/]+)?/?$", "dest": "/index.html" },
    { "src": "^/.*$", "status": 404, "dest": "/index.html" }
  ]
}
